# Flutter/Dart build artifacts — applies across every package in this
# monorepo since these patterns match at any depth.
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
build/
*.g.dart
.pub-cache/
.pub/

# Melos-generated — regenerated by `melos bootstrap`, not source.
pubspec_overrides.yaml

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Golden test images ARE tracked on purpose — do NOT ignore
# test/goldens/ or test/failures/. failures/ is generated only when a
# golden test fails locally (a diff artifact for you to inspect before
# deciding whether to update the reference image); the CI workflow
# uploads it as a build artifact rather than relying on it being
# committed, so it's fine that it isn't tracked. goldens/ itself is the
# committed reference and must NOT be excluded by any broader build/
# pattern above.
!**/test/goldens/
packages/*/test/failures/
example/test/failures/
widgetbook/test/failures/

# Platform build folders (created by `flutter create`/`flutter run` if
# you ever add platform targets to example/ or widgetbook/)
**/android/.gradle/
**/ios/Pods/
**/ios/.symlinks/
**/macos/Pods/
**/windows/flutter/ephemeral/
**/linux/flutter/ephemeral/
# Note: deliberately NOT ignoring **/web/ — a web/ platform folder
# holds source files (index.html, manifest.json) that should be
# committed, not build output. Only build/web/ (already covered by
# the top-level build/ rule above) is generated.

# Local reference material, not part of the project.
llms-full.txt

